@echo off\nREM ================================================\nREM Arabic Letters Assessment - Windows 11 Setup\nREM ================================================\nchcp 65001 >nul\necho.\necho ╔════════════════════════════════════════════════╗\necho ║  تقييم الحروف العربية - إعداد Windows 11      ║\necho ║  Arabic Letters Assessment Setup              ║\necho ╚════════════════════════════════════════════════╝\necho.\n\nREM Check if Node.js is installed\necho [1/4] التحقق من تثبيت Node.js...\necho Checking Node.js installation...\nnode --version >nul 2>&1\nif errorlevel 1 (\n    echo.\n    echo ❌ Node.js غير مثبت / Node.js is not installed\n    echo.\n    echo الحل / Solution:\n    echo 1. اذهب إلى https://nodejs.org/\n    echo 2. اختر LTS version\n    echo 3. ثبّت البرنامج\n    echo 4. أعد تشغيل هذا الملف\n    echo.\n    pause\n    exit /b 1\n)\necho ✅ Node.js موجود / Node.js found: %NODE_VERSION%\nnode --version\necho.\n\nREM Check if npm is installed\necho [2/4] التحقق من تثبيت npm...\necho Checking npm installation...\nnpm --version >nul 2>&1\nif errorlevel 1 (\n    echo ❌ npm غير مثبت\n    pause\n    exit /b 1\n)\necho ✅ npm موجود / npm found:\nnpm --version\necho.\n\nREM Install dependencies\necho [3/4] تثبيت المتطلبات / Installing dependencies...\necho هذقد يستغرق عدة دقائق...\necho This may take several minutes...\necho.\nnpm install\nif errorlevel 1 (\n    echo.\n    echo ❌ فشل التثبيت / Installation failed\n    echo اتصل بصاحب المشروع / Contact project owner\n    pause\n    exit /b 1\n)\necho.\necho ✅ تم تثبيت المتطلبات بنجاح / Dependencies installed successfully\necho.\n\nREM Create start script\necho [4/4] إنشاء ملف البدء / Creating startup script...\necho.\n\nREM Show summary\necho ╔════════════════════════════════════════════════╗\necho ║         ✅ الإعداد اكتمل بنجاح                  ║\necho ║         Setup Completed Successfully           ║\necho ╚════════════════════════════════════════════════╝\necho.\necho الخطوة التالية / Next Step:\necho ======================================\necho اختر من الخيارات التالية:\necho Choose from the following options:\necho.\necho 1) تشغيل المشروع محلياً / Run locally (Default: http://localhost:3000)\necho 2) تشغيل على منفذ مخصص / Run on custom port\necho 3) خروج / Exit\necho.\nset /p choice=\"اختيارك / Your choice (1-3): \"\n\nif \"%choice%\"==\"1\" (\n    echo.\n    echo جاري البدء / Starting...\n    echo.\n    timeout /t 2 /nobreak\n    start http://localhost:3000\n    npm start\n) else if \"%choice%\"==\"2\" (\n    set /p port=\"أدخل رقم المنفذ / Enter port number (default 3000): \"\n    if \"%port%\"==\"\" set port=3000\n    echo.\n    echo جاري البدء على المنفذ %port% / Starting on port %port%...\n    echo.\n    timeout /t 2 /nobreak\n    start http://localhost:%port%\n    set PORT=%port% && npm start\n) else (\n    echo.\n    echo للبدء لاحقاً استخدم / To start later use:\n    echo npm start\n    echo.\n)\n\npause\n"